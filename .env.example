# vision-qc-agent — 配置模板
#
# 复制为 .env 后按需修改。`.env` 已被 .gitignore 忽略，不会提交。
# 所有变量都有默认值：不建 .env、不配任何变量，`npm start` 也能以「演示模式」跑起来。
# 数值型变量写错会在启动时直接报错并指明变量名，不会静默失效。

# ---------------------------------------------------------------------------
# 视觉线路
# ---------------------------------------------------------------------------
# 供应商：deepseek | openai | anthropic（写错会启动失败）
QC_PROVIDER=deepseek
# 省略则用该供应商的默认模型
# QC_MODEL=deepseek-v4-flash-vision-exp
# 省略则用内置 baseURL；自定义网关时填到 /v1 这一级
# QC_BASE_URL=https://api.deepseek.com/v1
# 指定从哪个环境变量读 key（默认随供应商：DEEPSEEK_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY）
# QC_API_KEY_ENV=DEEPSEEK_API_KEY

# ---------------------------------------------------------------------------
# 凭据（三者任选其一，解析顺序：环境变量 → ~/.dsh/.credentials.yaml → 本项目 .env）
# ---------------------------------------------------------------------------
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# 运行参数
# ---------------------------------------------------------------------------
# 强制演示模式：不调用模型，用本地像素指标推断事实（结论会标注为「模式化估计」）
QC_MOCK=0
# 监听端口（默认 4599）
# QC_PORT=4599
# 单批最多处理几张图（1–100，默认 12）；超出的部分会在 batch-start 事件里报告 dropped 数量
# QC_MAX_IMAGES=12
# 单次上传字节上限（默认 12 MB）
# QC_MAX_UPLOAD_BYTES=12582912
# 并发调用数（1–16，默认 3）
# QC_CONCURRENCY=3
# 单次模型请求超时（毫秒，默认 120000）
# QC_TIMEOUT_MS=120000
# 运行时数据目录（推翻日志等），默认 <项目>/data
# QC_DATA_DIR=./data

# ---------------------------------------------------------------------------
# 内部/测试开关（一般不用手填）
# ---------------------------------------------------------------------------
# 1 = 不把 Markdown 报告写入 reports/（测试与演示用）
# QC_NO_SAVE=0
# 1 = 不监听端口，只导出 server 实例（供进程内集成测试使用）
# QC_NO_LISTEN=0
